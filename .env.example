# voice-booking — local environment.
#
# Copy to `.env` and fill in. `booking_engine/config.py` reads this file
# directly (since 2026-09-24), so the README's run command works as written:
#
#   uvicorn booking_engine.api.app:create_app --factory --host 127.0.0.1 --port 8080
#
# Real environment variables take priority over this file, so `fly secrets` in a
# deploy and an explicit `export` locally both still win. Every name here is
# lowercase in Settings; the mapping is automatic.
#
# This file exists because its absence cost a week: a local stack missing the
# three cross-service variables below classifies nothing, charges nothing and
# books nothing, and every one of those failures is a *silent* fail-closed. There
# is no error to find. See docs/knowledge/operations.md in the webapp repo for
# the local port map (webapp 3000, market-intel 3001, this service 8080).

# ── Required for anything to work ──────────────────────────────────────────
# The QA Neon branch. Shared with the webapp and the market-intel engine.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require

# The webapp's token for this service's `/api/v1/*` control plane — buys phone
# numbers, sends SMS. The webapp knows it as VOICE_AGENT_SECRET; same value.
CONTROL_PLANE_SECRET=copy-the-webapp-VOICE_AGENT_SECRET

# ── The three that fail closed in silence when unset ───────────────────────
# Inbound WhatsApp classification. Unset means `classify()` returns None on every
# message — nothing raises, nothing logs at error level, and every inbound lands
# unrouted on a human. The secret is the engine's MARKET_INTEL_SECRET.
MARKET_INTEL_API_URL=http://127.0.0.1:3001
MARKET_INTEL_SECRET=copy-the-market-intel-MARKET_INTEL_SECRET

# Where this repo charges the shop's AI basket (the webapp owns ai_token_basket).
# Unset means every charge is refused and logged — the work still happens, it is
# just never billed. Uses MARKET_INTEL_SECRET above as the bearer.
WEBAPP_BASE_URL=http://localhost:3000

# The bearer for THIS repo's agent-facing surface: `/voice/tools/*`,
# `/voice/events/*`, `/mcp`. Presented by OpenAI Realtime and by the
# marketing-engine's WhatsApp booking agent — set the same value as that repo's
# VOICE_AGENT_TOOL_SECRET or every tool call 401s and every turn escalates.
#
# Was OPENAI_TOOL_SECRET until 2026-09-22 and the old name is NOT read: a .env
# still carrying it has an empty tool secret and no way to tell.
# Deliberately not CONTROL_PLANE_SECRET — that one can buy numbers, and a leaked
# agent token must not escalate to it.
VOICE_AGENT_TOOL_SECRET=copy-the-market-intel-VOICE_AGENT_TOOL_SECRET

# ── Twilio (telephony) ─────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# The one-time regulatory Bundle (KYC) for the shared Kairo entity, reused across
# every provisioned DID. Number purchase fails without them in the countries that
# require it — see AGENTS.md, "Telephony provider: Telnyx -> Twilio".
# TWILIO_BUNDLE_SID=
# TWILIO_ADDRESS_SID=
# TWILIO_DEFAULT_COUNTRY=EE
# Public origin Twilio and Meta webhooks are pointed at. ngrok it for local work;
# an unreachable value means callbacks silently never arrive.
PUBLIC_BASE_URL=https://kairo-booking-engine-qa.fly.dev

# ── OpenAI (voice) ─────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_SIP_PROJECT_ID=proj_xxxxxxxxxxxx
# OPENAI_REALTIME_MODEL=gpt-realtime
# OPENAI_WEBHOOK_SECRET=
# Shop a bare SIP test call falls back to, QA only. Empty = unroutable, which is
# the right answer in production.
# SIP_TEST_FALLBACK_SHOP_ID=

# ── Meta / WhatsApp Cloud API (Tech Provider, no BSP) ──────────────────────
# app_id / config_id / solution_id are served to the webapp so Embedded Signup
# has one source of truth — public values, not secrets.
META_APP_ID=
META_CONFIG_ID=
# META_SOLUTION_ID=
# Verifies X-Hub-Signature-256 on every inbound webhook and signs the Embedded
# Signup code exchange.
META_APP_SECRET=
# The string Meta echoes back when it first registers the webhook.
META_VERIFY_TOKEN=
# Kairo's own WABA — templates are created there by hand and reviewed by Meta
# before ensure_templates pushes them into a customer's WABA. Empty fails closed:
# nothing propagates.
META_KAIRO_WABA_ID=
META_KAIRO_TOKEN=
# Publicly-hosted sample PDF Meta reviews for the DOCUMENT-header receipt
# template. Empty fails closed rather than submitting a header-less template.
META_RECEIPT_SAMPLE_URL=

# Fernet key encrypting whatsapp.senders.access_token at rest. Empty keeps the
# pre-2026-09-20 behaviour — plaintext, logged loudly at every write — because
# refusing would take WhatsApp offline to fix a threat that is about a database
# dump. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NOTE: a token written under a key cannot be read without it. Do not set this
# locally and then point at a database whose rows were encrypted elsewhere.
# WHATSAPP_TOKEN_KEY=

# Meta caps a Tech Provider's new-customer onboarding per rolling 7 days: 10
# until Access Verification is complete, 200 after. Flip once it is.
# META_ACCESS_VERIFIED=false

# ── Tests ──────────────────────────────────────────────────────────────────
# tests/live_db/ runs against this and refuses a production URL. Unset, those
# tests skip. Note they assert against 02_seed_data.sql's fixtures, which the
# shared QA branch does not carry — see tests/live_db/conftest.py.
# TEST_DATABASE_URL=
